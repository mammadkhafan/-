; Open Road Driving Simulator - Godot 4
config_version=5
[application]
config/name="Open Road Driving Simulator"
run/main_scene="res://scenes/main.tscn"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
handheld/orientation=1
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.48,0.68,0.86,1)
[input]
throttle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
clutch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
gear_neutral={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":78)]}
gear_reverse={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
gear_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
gear_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
gear_3={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}
gear_4={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":52)]}
gear_5={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":53)]}
gear_6={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":54)]}
engine_start={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
